# Configuration de FamilyCocon : copier en .env puis adapter.
# Seule FC_URL_PUBLIQUE est vraiment à régler ; le reste a des valeurs par défaut.

# Adresse vue par les navigateurs (sert aux liens d'invitation, aux cookies
# « Secure » et aux notifications). En https derrière le reverse proxy.
FC_URL_PUBLIQUE=https://famille.exemple.fr

# Reverse proxy de confiance (adresse ou réseau, séparés par des virgules) :
# l'adresse IP réelle des visiteurs est lue dans X-Forwarded-For seulement
# si la requête vient de là. Réseau Docker par défaut : 172.16.0.0/12.
FC_PROXYS=172.16.0.0/12

# Qui peut créer une famille :
#   premiere : seulement la toute première (défaut, serveur d'une seule famille)
#   ouverte  : tout le monde
#   fermee   : personne
FC_INSCRIPTIONS=premiere

# Adresse d'écoute et dossier des données DANS le conteneur. Déjà réglés par
# l'image (:8080 et /donnees) : à changer seulement hors Docker. Le chemin
# ne doit contenir ni ?, ni #, ni apostrophe.
# FC_ADRESSE=:8080
# FC_DONNEES=/donnees

# Journal : niveau (debug, info, warn, error) et format (json ou texte).
FC_NIVEAU_LOGS=info
FC_FORMAT_LOGS=json

# Fuseau horaire du serveur (heure des sauvegardes et des logs). Le fuseau
# de l'agenda se règle dans l'interface (réglages de la famille).
TZ=Europe/Paris

# Sauvegarde automatique de la base chaque jour à cette heure (fuseau TZ),
# dans le volume (/donnees/sauvegardes) ; « non » pour la désactiver.
FC_SAUVEGARDE_HEURE=03:30
# Nombre de sauvegardes automatiques gardées.
FC_SAUVEGARDE_GARDER=7

# Durée d'une session (jours) : sur le téléphone, on reste connecté.
FC_DUREE_SESSION_JOURS=90
# Durée maximale d'une session, même utilisée chaque jour (puis reconnexion).
FC_SESSION_MAX_JOURS=365

# Contact transmis aux services de notification (Google, Apple, Mozilla)
# en cas de problème : « mailto:vous@exemple.fr ». Par défaut : admin@<domaine>.
# FC_CONTACT_PUSH=mailto:vous@exemple.fr

# Mémoire maximale visée par le ramasse-miettes de Go.
GOMEMLIMIT=48MiB
