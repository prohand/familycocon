    { "src": "/statique/img/icone-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/statique/img/icone-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "/statique/img/icone.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" }
